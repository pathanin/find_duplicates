{
  "name": "web-lsp",
  "description": "HTML/CSS/JSON language servers (vscode-langservers-extracted) for static/",
  "version": "1.0.0",
  "lspServers": {
    "html": {
      "command": "/opt/homebrew/bin/vscode-html-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": { ".html": "html" }
    },
    "css": {
      "command": "/opt/homebrew/bin/vscode-css-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": { ".css": "css" }
    },
    "json": {
      "command": "/opt/homebrew/bin/vscode-json-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": { ".json": "json" }
    }
  }
}
